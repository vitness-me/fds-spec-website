# Dependencies
node_modules/

# Build output — produced by CI and by `prepublishOnly`.
# npm packs `files: ["dist"]` from the built output, so it never needs committing.
dist/

# Local scratch
packages/fds-transformer/poc-test/output/

# Schema review site written by `npm run schema-review`
.schema-review/

# OS
.DS_Store

# Agent worktrees. Created under .claude/worktrees/ when work is split across
# parallel sessions; they are checkouts of this repository, not content of it.
.claude/
