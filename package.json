{
  "name": "fds-spec",
  "version": "0.0.0",
  "private": true,
  "description": "Fitness Data Standard \u2014 specification tooling",
  "type": "module",
  "scripts": {
    "build:schemas": "node scripts/build-schemas.mjs",
    "check:schemas": "node scripts/build-schemas.mjs --check",
    "verify": "bash scripts/ci-local.sh",
    "check:metrics": "node scripts/check-metrics-guide.mjs",
    "check:doc-examples": "node scripts/check-doc-examples.mjs --self-test && node scripts/check-doc-examples.mjs",
    "check:commands": "node scripts/check-doc-commands.mjs --self-test && node scripts/check-doc-commands.mjs",
    "check:mapping": "node scripts/check-mapping-schema.mjs --self-test",
    "check:transform": "node scripts/check-transform.mjs --self-test",
    "check:prescription": "node scripts/check-prescription.mjs",
    "check:rfc": "node scripts/check-rfc-fields.mjs",
    "check:refs": "node scripts/check-ref-integrity.mjs --self-test && node scripts/check-ref-integrity.mjs",
    "check:mirrors": "node scripts/check-doc-mirrors.mjs",
    "check:license": "node scripts/check-license.mjs",
    "check:usecases": "node scripts/check-usecases.mjs",
    "check:scenarios": "node scripts/check-scenarios.mjs",
    "check:registries": "node scripts/check-registries.mjs",
    "check:skill": "node scripts/check-skill.mjs --self-test && node scripts/check-skill.mjs",
    "check:versions": "node scripts/check-versions.mjs",
    "check:packages": "node scripts/check-packages.mjs --self-test && node scripts/check-packages.mjs",
    "check:published": "node scripts/check-published.mjs",
    "check:translations": "node scripts/check-translations.mjs --self-test && node scripts/check-translations.mjs",
    "check:redirects": "node scripts/check-locale-redirects.mjs",
    "check:publish-auth": "node scripts/check-publish-auth.mjs --self-test"
  }
}
