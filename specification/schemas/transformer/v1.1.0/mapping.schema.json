{
  "$id": "https://spec.vitness.me/schemas/transformer/v1.1.0/mapping.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FDS Transformer Mapping Configuration",
  "description": "Every configuration key the FDS Transformer reads, and nothing else. `additionalProperties` is closed throughout on purpose: this document exists so an editor can tell a user that a key is misspelled or does not exist, and a schema that accepts anything cannot say that. A key the tool grew is a defect in this document, not licence to write one the tool ignores.",
  "type": "object",
  "required": ["version", "targetSchema", "mappings"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema reference for IDE support"
    },
    "description": {
      "type": "string",
      "description": "A note to whoever reads this file. The transformer never reads it — it is here, like `$schema`, because a configuration file is written by a person."
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Mapping configuration version"
    },
    "targetSchema": {
      "type": "object",
      "required": ["version"],
      "additionalProperties": false,
      "description": "Target FDS schema configuration",
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "description": "FDS schema version to target"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "description": "URL to the FDS schema (optional, will use bundled if not specified)"
        },
        "entity": {
          "type": "string",
          "enum": ["exercise", "equipment", "muscle", "muscle-category", "body-atlas"],
          "default": "exercise",
          "description": "FDS entity type to transform to"
        }
      }
    },
    "registries": {
      "type": "object",
      "description": "Registry configuration for lookups",
      "additionalProperties": false,
      "properties": {
        "muscles": {
          "$ref": "#/$defs/registryConfig"
        },
        "equipment": {
          "$ref": "#/$defs/registryConfig"
        },
        "muscleCategories": {
          "$ref": "#/$defs/registryConfig"
        }
      }
    },
    "mappings": {
      "type": "object",
      "description": "Field mapping definitions",
      "additionalProperties": {
        "$ref": "#/$defs/fieldMapping"
      }
    },
    "allowUnsafeEval": {
      "type": "boolean",
      "default": false,
      "description": "Allow unsafe JavaScript evaluation in mapping conditions. A mapping's `condition` is an expression the transformer evaluates against your source data; with this false it is not evaluated at all and the mapping is skipped with a warning."
    },
    "enrichment": {
      "type": "object",
      "description": "AI enrichment configuration",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable/disable AI enrichment globally"
        },
        "provider": {
          "type": "string",
          "enum": ["openrouter", "openai", "anthropic", "ollama"],
          "default": "openrouter",
          "description": "AI provider to use"
        },
        "model": {
          "type": "string",
          "description": "Model identifier (e.g., 'anthropic/claude-3.5-sonnet')"
        },
        "apiKey": {
          "type": "string",
          "description": "API key (prefer env var OPENROUTER_API_KEY)"
        },
        "baseUrl": {
          "type": "string",
          "format": "uri",
          "description": "Custom API base URL"
        },
        "options": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "temperature": {
              "type": "number",
              "minimum": 0,
              "maximum": 2,
              "default": 0.3
            },
            "maxTokens": {
              "type": "integer",
              "minimum": 1,
              "default": 1024
            },
            "maxRetries": {
              "type": "integer",
              "minimum": 0,
              "default": 3
            },
            "retryDelay": {
              "type": "integer",
              "minimum": 0,
              "default": 1000,
              "description": "Retry delay in milliseconds"
            },
            "rateLimit": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "requestsPerMinute": {
                  "type": "integer",
                  "minimum": 1,
                  "default": 60
                },
                "tokensPerMinute": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        },
        "batch": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "concurrency": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "default": 5
            },
            "chunkSize": {
              "type": "integer",
              "minimum": 1,
              "default": 10,
              "description": "Number of items to process per batch"
            }
          }
        },
        "defaultFields": {
          "oneOf": [
            {
              "type": "string",
              "enum": ["all", "none"]
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ],
          "default": "all",
          "description": "Fields to enrich by default when source is missing"
        },
        "skipFields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Fields to skip even if empty"
        },
        "tiers": {
          "type": "object",
          "additionalProperties": false,
          "description": "Model settings per complexity tier. Tiered enrichment runs only when both `tiers` and `fields` are present; a tier left out here falls back to the transformer's own defaults for that tier.",
          "properties": {
            "simple": {
              "$ref": "#/$defs/tierConfig"
            },
            "medium": {
              "$ref": "#/$defs/tierConfig"
            },
            "complex": {
              "$ref": "#/$defs/tierConfig"
            }
          }
        },
        "fields": {
          "type": "object",
          "description": "Which target field each tier enriches, keyed by dotted field path. Present together with `tiers`, this selects tiered enrichment over the per-field `enrichment` blocks in `mappings`.",
          "additionalProperties": {
            "$ref": "#/$defs/tieredFieldEnrichment"
          }
        },
        "fallback": {
          "type": "object",
          "additionalProperties": false,
          "required": ["retries", "degradeModel", "useDefaults", "degradeChain"],
          "description": "What to do when a tier's request fails. Supplied whole or not at all: the transformer uses this object in place of its defaults rather than merging with them, so a partial one leaves the degradation path undefined at the moment it is needed.",
          "properties": {
            "retries": {
              "type": "integer",
              "minimum": 0,
              "description": "Retries at the same tier before degrading"
            },
            "degradeModel": {
              "type": "boolean",
              "description": "Retry at the next tier down once retries are exhausted"
            },
            "useDefaults": {
              "type": "boolean",
              "description": "Fall back to default values when every tier fails"
            },
            "degradeChain": {
              "type": "object",
              "additionalProperties": false,
              "required": ["complex", "medium", "simple"],
              "description": "The tier each tier degrades to. `simple` is the floor and degrades to nothing.",
              "properties": {
                "complex": {
                  "oneOf": [{ "$ref": "#/$defs/tierName" }, { "type": "null" }]
                },
                "medium": {
                  "oneOf": [{ "$ref": "#/$defs/tierName" }, { "type": "null" }]
                },
                "simple": {
                  "type": "null"
                }
              }
            }
          }
        },
        "rateLimit": {
          "type": "object",
          "additionalProperties": false,
          "description": "Request pacing and backoff for tiered enrichment. Each property falls back to the transformer's default independently, so a partial object is fine.",
          "properties": {
            "requestsPerMinute": {
              "type": "integer",
              "minimum": 1,
              "default": 50
            },
            "backoffStrategy": {
              "type": "string",
              "enum": ["exponential", "linear", "fixed"],
              "default": "exponential"
            },
            "initialBackoffMs": {
              "type": "integer",
              "minimum": 0,
              "default": 1000
            },
            "maxBackoffMs": {
              "type": "integer",
              "minimum": 0,
              "default": 60000
            }
          }
        },
        "checkpoint": {
          "type": "object",
          "additionalProperties": false,
          "description": "Periodic saving of partial enrichment results, so a long run can be resumed with `--resume`.",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "saveInterval": {
              "type": "integer",
              "minimum": 1,
              "default": 10,
              "description": "Save after this many enriched items"
            }
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "description": "Output validation configuration",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "strict": {
          "type": "boolean",
          "default": true,
          "description": "Fail on any validation error"
        },
        "failOnError": {
          "type": "boolean",
          "default": false,
          "description": "Stop processing on first error"
        },
        "outputErrors": {
          "type": "string",
          "description": "Path to write validation errors"
        }
      }
    },
    "output": {
      "type": "object",
      "description": "Output configuration",
      "additionalProperties": false,
      "properties": {
        "format": {
          "type": "string",
          "enum": ["json", "jsonl", "ndjson"],
          "default": "json"
        },
        "pretty": {
          "type": "boolean",
          "default": true,
          "description": "Pretty-print JSON output"
        },
        "directory": {
          "type": "string",
          "description": "Output directory path"
        },
        "naming": {
          "type": "string",
          "default": "{{slug}}.json",
          "description": "Output file naming template (supports {{id}}, {{slug}}, {{index}})"
        },
        "singleFile": {
          "type": "boolean",
          "default": false,
          "description": "Output all items to a single file"
        },
        "singleFileName": {
          "type": "string",
          "default": "output.json",
          "description": "Single file name when singleFile is true"
        }
      }
    },
    "plugins": {
      "type": "array",
      "description": "Custom transform plugins to load",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "description": "Plugin package name or path"
          },
          {
            "type": "object",
            "required": ["name"],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "description": "Plugin package name or path"
              },
              "options": {
                "type": "object",
                "description": "Plugin-specific options"
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "tierName": {
      "type": "string",
      "enum": ["simple", "medium", "complex"],
      "description": "A complexity tier. Fields are grouped into these so a cheap model can do the easy ones."
    },
    "tierConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "temperature", "maxTokens", "batchSize", "priority"],
      "description": "Model settings for one tier. Stated whole: cost estimation reads `model` and `batchSize` from this object directly rather than through the merge that supplies defaults elsewhere, so a half-written tier produces a cost estimate of NaN rather than an error.",
      "properties": {
        "model": {
          "type": "string",
          "description": "Provider model identifier, e.g. \"anthropic/claude-haiku-4.5\""
        },
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "maxTokens": {
          "type": "integer",
          "minimum": 1
        },
        "batchSize": {
          "type": "integer",
          "minimum": 1,
          "description": "Items sent to the model in one request"
        },
        "priority": {
          "type": "string",
          "enum": ["speed", "balanced", "accuracy"],
          "description": "What this tier is optimised for. A hint recorded with the tier, not a setting the provider receives."
        }
      }
    },
    "tieredFieldEnrichment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier", "prompt"],
      "description": "One target field's place in the tiered system.",
      "properties": {
        "tier": {
          "$ref": "#/$defs/tierName"
        },
        "prompt": {
          "type": "string",
          "description": "Prompt template key"
        },
        "enum": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The values this field may take, for a constrained field"
        },
        "required": {
          "type": "boolean",
          "description": "Fail the item if the field could not be enriched"
        }
      }
    },
    "registryConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "oneOf": [
            {
              "type": "string",
              "enum": ["remote", "local", "inline"]
            },
            {
              "type": "string",
              "format": "uri"
            }
          ],
          "description": "Where this registry comes from. The loader takes `inline` if present, then `local`, then the URL in `url` — so this names your intent and the sibling property carries the value. 'remote' means fetch `url` and requires it: FDS publishes muscles, equipment and muscle categories only as illustrative catalogs whose ids belong to no provider, so there is no default remote source to fall back on, and asking for one without naming it fails at load rather than fetching. A bare URL in this position is accepted for compatibility with 1.0.0 configurations and is not read; put it in `url`."
        },
        "url": {
          "type": "string",
          "format": "uri",
          "description": "URL to fetch the registry from. Required by 'remote', and the supported way to name a catalog — including the illustrative one, if that is genuinely what you want."
        },
        "local": {
          "type": "string",
          "description": "Path to local registry file"
        },
        "inline": {
          "type": "array",
          "description": "Inline registry data",
          "items": {
            "type": "object"
          }
        },
        "fallback": {
          "type": "string",
          "enum": ["remote", "local", "inline"],
          "description": "Source to try when the primary one fails. 'remote' needs `url` here too, and is checked before any loading is attempted — a registry with no source it can name fails immediately rather than after the primary has failed."
        },
        "cache": {
          "type": "boolean",
          "default": true,
          "description": "Cache remote registries locally"
        }
      }
    },
    "fieldMapping": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "from": {
              "oneOf": [
                {
                  "type": "string",
                  "description": "Source field path (dot notation for nested)"
                },
                {
                  "type": "null",
                  "description": "No source field (for generated/enriched fields)"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Multiple source fields (for merging)"
                }
              ]
            },
            "transform": {
              "oneOf": [
                {
                  "type": "string",
                  "description": "Transform function name"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Chain of transform functions"
                }
              ]
            },
            "options": {
              "type": "object",
              "description": "Transform-specific options"
            },
            "enrichment": {
              "$ref": "#/$defs/fieldEnrichment"
            },
            "default": {
              "description": "Default value if source is missing/empty"
            },
            "required": {
              "type": "boolean",
              "default": false,
              "description": "Fail if field cannot be populated"
            },
            "condition": {
              "type": "string",
              "description": "JavaScript expression to conditionally apply mapping"
            }
          }
        },
        {
          "type": "string",
          "description": "Simple mapping: source field path"
        }
      ]
    },
    "fieldEnrichment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "prompt": {
          "type": "string",
          "description": "Prompt template name or custom prompt"
        },
        "context": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Source fields to include as context for AI"
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Specific sub-fields to enrich"
        },
        "when": {
          "type": "string",
          "enum": ["always", "missing", "empty", "notFound"],
          "default": "missing",
          "description": "When to trigger enrichment"
        },
        "validate": {
          "type": "boolean",
          "default": true,
          "description": "Validate AI output against schema"
        },
        "fallback": {
          "description": "Fallback value if enrichment fails"
        }
      }
    },
    "builtinTransforms": {
      "description": "Documentation of built-in transforms",
      "enum": [
        "slugify",
        "titleCase",
        "lowerCase",
        "upperCase",
        "camelCase",
        "kebabCase",
        "snakeCase",
        "trim",
        "uuid",
        "prefixUUID",
        "timestamp",
        "toArray",
        "toMediaArray",
        "registryLookup",
        "autoGenerate",
        "urlTransform",
        "jsonParse",
        "jsonStringify",
        "split",
        "join",
        "replace",
        "template",
        "coalesce",
        "pick",
        "omit",
        "map",
        "filter"
      ]
    }
  }
}
