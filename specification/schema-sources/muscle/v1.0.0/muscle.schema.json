{
  "$id": "https://spec.vitness.me/schemas/muscle/v1.0.0/muscle.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FDS Muscle (v1.0.0)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "canonical",
    "classification",
    "metadata"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "id": {
      "type": "string"
    },
    "canonical": {
      "$ref": "https://spec.vitness.me/schemas/common/v1.0.0/common.schema.json#/$defs/canonical"
    },
    "classification": {
      "type": "object",
      "required": [
        "categoryId",
        "region"
      ],
      "additionalProperties": false,
      "properties": {
        "categoryId": {
          "type": "string"
        },
        "region": {
          "$ref": "#/$defs/regionGroup"
        },
        "laterality": {
          "$ref": "#/$defs/laterality"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "media": {
      "$ref": "https://spec.vitness.me/schemas/common/v1.0.0/common.schema.json#/$defs/media"
    },
    "attributes": {
      "type": "object",
      "additionalProperties": true
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    },
    "heatmap": {
      "type": "object",
      "required": [
        "atlasId",
        "regions"
      ],
      "additionalProperties": false,
      "properties": {
        "atlasId": {
          "type": "string"
        },
        "regions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "areaId"
            ],
            "additionalProperties": false,
            "properties": {
              "areaId": {
                "type": "string"
              },
              "weight": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "default": 1
              }
            }
          }
        }
      }
    },
    "metadata": {
      "$ref": "https://spec.vitness.me/schemas/common/v1.0.0/common.schema.json#/$defs/metadata"
    }
  },
  "$defs": {
    "regionGroup": {
      "type": "string",
      "enum": [
        "upper-front",
        "upper-back",
        "lower-front",
        "lower-back",
        "core",
        "full-body",
        "n/a"
      ]
    },
    "laterality": {
      "type": "string",
      "enum": [
        "left",
        "right",
        "bilateral",
        "unilateral",
        "n/a"
      ]
    }
  }
}
