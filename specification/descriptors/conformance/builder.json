    {"id": "other-kettlebell-clean-and-press", "entry": {"id": "one-arm-kettlebell-clean-and-press", "answers": {"subject": "usual", "movement": "other", "changes": ["sides"], "motion.phases": "3", "p1.kind": "usual", "p1.joints": ["hip"], "p1.hip": ["ext"], "p1.short": ["usual"], "p1.also": "usual", "p2.kind": "usual", "p2.joints": ["el"], "p2.el": ["flex"], "p2.short": ["usual"], "p2.also": "usual", "p3.kind": "usual", "p3.joints": ["el", "hip", "kn", "sh"], "p3.el": ["ext"], "p3.hip": ["ext"], "p3.kn": ["ext"], "p3.sh": ["up-overhead"], "p3.short": ["hip", "kn"], "p3.also": "usual", "orientation": "standing", "load": "implement", "imp1": "kb", "hold1": "hands", "symmetry": "u", "symmetry.scope": "arms"}}, "expect": {"fxi": "FXI=1.0S/m:hip.ext>el.flex>el.ext+hip.ext-+kn.ext-+sh.flex/o:standing/l:kb@hands/x:u@arms", "fxe": "FXE=1.0S/k:imp/f:bell.kettle", "fxiProvenance": "owner", "fxiGap": null}, "note": "Three phases, a short drive and a scoped symmetry."},
    {"id": "other-dumbbell-lunge-and-press", "entry": {"id": "dumbbell-reverse-lunge-and-press", "answers": {"subject": "usual", "movement": "other", "changes": ["footwork", "sides"], "motion.phases": "2", "p1.kind": "usual", "p1.joints": ["el", "sh"], "p1.el": ["ext"], "p1.sh": ["up-overhead"], "p1.short": ["usual"], "p1.also": "usual", "p2.kind": "usual", "p2.joints": ["hip", "kn"], "p2.hip": ["ext"], "p2.kn": ["ext"], "p2.short": ["usual"], "p2.also": "usual", "orientation": "standing", "load": "implement", "imp1": "db", "hold1": "hands", "footwork": "step.back", "symmetry": "u", "symmetry.scope": "legs"}}, "expect": {"fxi": "FXI=1.0S/m:el.ext+sh.flex>hip.ext+kn.ext/o:standing/f:step.back/l:db@hands/x:u@legs", "fxe": "FXE=1.0S/k:imp/f:bell.dumb", "fxiProvenance": "owner", "fxiGap": null}, "note": "A scope the motion does not imply is kept."},
