    {"id": "other-held-push", "entry": {"id": "sit-up-heels-pulled-down", "answers": {"subject": "usual", "movement": "other", "changes": ["usual"], "motion.phases": "1", "p1.kind": "usual", "p1.joints": ["hip", "sp"], "p1.hip": ["flex"], "p1.sp": ["flex"], "p1.short": ["usual"], "p1.also": "yes", "p1b.kind": "hold", "p1b.joints": ["kn"], "p1b.kn": ["flex"], "orientation": "supine", "load": "bodyweight", "symmetry": "b"}}, "expect": {"fxi": "FXI=1.0S/m:=kn.flex|hip.flex+sp.flex/o:supine/l:bw", "fxe": "FXE=1.0S/k:none", "fxiProvenance": "owner", "fxiGap": null}, "note": "A held push of a limb that does not move is a second, held part of the phase."},
