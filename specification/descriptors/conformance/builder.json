    {"id": "worked-barbell-back-squat", "entry": {"id": "barbell-back-squat", "answers": {"subject": "usual", "movement": "other", "changes": ["usual"], "motion.phases": "1", "p1.kind": "usual", "p1.joints": ["hip", "kn"], "p1.hip": ["ext"], "p1.kn": ["ext"], "p1.short": ["usual"], "p1.also": "usual", "orientation": "standing", "load": "implement", "imp1": "bb", "hold1": "back", "symmetry": "b"}}, "expect": {"fxi": "FXI=1.0S/m:hip.ext+kn.ext/o:standing/l:bb@back", "fxe": "FXE=1.0S/k:imp/f:bar.straight", "fxiProvenance": "owner", "fxiGap": null}, "note": "The worked example \"Barbell back squat\": the motion described joint by joint."},
