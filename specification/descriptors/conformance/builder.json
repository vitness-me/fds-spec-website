    {"id": "other-line-neck", "entry": {"id": "press-to-the-throat", "answers": {"subject": "usual", "movement": "other", "changes": ["line"], "motion.phases": "1", "p1.kind": "usual", "p1.joints": ["el", "sh"], "p1.el": ["ext"], "p1.sh": ["away-square"], "p1.short": ["usual"], "p1.also": "usual", "orientation": "supine", "load": "implement", "imp1": "bb", "hold1": "hands", "symmetry": "b", "line": ["neck"]}}, "expect": {"fxi": "FXI=1.0S/m:el.ext+sh.hadd/o:supine/l:bb@hands/p:neck", "fxe": "FXE=1.0S/k:imp/f:bar.straight", "fxiProvenance": "owner", "fxiGap": null}, "note": "The line answer \"neck\" writes p:neck."},
