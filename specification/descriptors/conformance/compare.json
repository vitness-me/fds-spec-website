{
  "tier": "compare",
  "rules": "1.4",
  "description": "Compare pairs. An FXI or FXE vector expects the overall relation and the relation of every layer, read as \"a is … than b\"; a combination FXE and an invalid pair expect no layers. Every FXI and FXE vector is also run with a and b swapped, expecting the inverse: refines and refined-by trade places, and so do narrower and broader. An FXM vector expects the grade over the anatomical leaves of fxm-vocabulary.json, the leaves shared, and which side is the container.",
  "vocabulary": "fxm-vocabulary.json",
  "vectors": [
    {"id": "fxi-identical", "kind": "fxi", "a": "FXI=1.0S/m:hip.ext+kn.ext/o:standing/l:bb@back", "b": "FXI=1.0S/m:hip.ext+kn.ext/o:standing/l:bb@back", "expect": {"relation": "identical", "layers": {"m": "equal", "o": "equal", "k": "equal", "f": "equal", "s": "equal", "l": "equal", "x": "equal", "g": "equal", "r": "equal", "h": "equal", "p": "equal"}}, "note": "Byte-equal canonical strings with no ? or *."},
    {"id": "fxi-identical-after-canonical", "kind": "fxi", "a": "FXI=1.0S/l:bb@back/o:standing/m:kn.ext+hip.ext", "b": "FXI=1.0S/m:hip.ext+kn.ext/o:standing/l:bb@back", "expect": {"relation": "identical", "layers": {"m": "equal", "o": "equal", "k": "equal", "f": "equal", "s": "equal", "l": "equal", "x": "equal", "g": "equal", "r": "equal", "h": "equal", "p": "equal"}}, "note": "Compare reads canonical forms, so spelling does not matter."},
    {"id": "fxi-equal-with-unknown-is-not-identical", "kind": "fxi", "a": "FXI=1.0S/m:hip.ext+kn.ext/o:?/l:bb@back", "b": "FXI=1.0S/m:hip.ext+kn.ext/o:?/l:bb@back", "expect": {"relation": "compatible", "layers": {"m": "equal", "o": "open", "k": "equal", "f": "equal", "s": "equal", "l": "equal", "x": "equal", "g": "equal", "r": "equal", "h": "equal", "p": "equal"}}, "note": "The same string holding ? is never identical."},
    {"id": "fxi-equal-with-generic-is-not-identical", "kind": "fxi", "a": "FXI=1.0S/m:hip.ext+kn.ext/o:*/l:bb@back", "b": "FXI=1.0S/m:hip.ext+kn.ext/o:*/l:bb@back", "expect": {"relation": "compatible", "layers": {"m": "equal", "o": "open", "k": "equal", "f": "equal", "s": "equal", "l": "equal", "x": "equal", "g": "equal", "r": "equal", "h": "equal", "p": "equal"}}, "note": "The same string holding * is never identical."},
    {"id": "fxi-refines-generic-orientation", "kind": "fxi", "a": "FXI=1.0S/m:hip.ext+kn.ext/o:standing/l:bb@back", "b": "FXI=1.0S/m:hip.ext+kn.ext/o:*/l:bb@back", "expect": {"relation": "refines", "layers": {"m": "equal", "o": "narrower", "k": "equal", "f": "equal", "s": "equal", "l": "equal", "x": "equal", "g": "equal", "r": "equal", "h": "equal", "p": "equal"}}, "note": "A known value refines *."},
    {"id": "fxi-refines-unknown-load", "kind": "fxi", "a": "FXI=1.0S/m:hip.ext+kn.ext/o:standing/l:bb@back", "b": "FXI=1.0S/m:hip.ext+kn.ext/o:standing/l:?", "expect": {"relation": "refines", "layers": {"m": "equal", "o": "equal", "k": "equal", "f": "equal", "s": "equal", "l": "narrower", "x": "equal", "g": "equal", "r": "equal", "h": "equal", "p": "equal"}}, "note": "A known load refines l:?."},
    {"id": "fxi-refines-unknown-implement", "kind": "fxi", "a": "FXI=1.0S/m:hip.ext+kn.ext/o:standing/l:bb@back", "b": "FXI=1.0S/m:hip.ext+kn.ext/o:standing/l:?@back", "expect": {"relation": "refines", "layers": {"m": "equal", "o": "equal", "k": "equal", "f": "equal", "s": "equal", "l": "narrower", "x": "equal", "g": "equal", "r": "equal", "h": "equal", "p": "equal"}}, "note": "A known implement refines ? at the same hold point."},
    {"id": "fxi-refines-unknown-hold", "kind": "fxi", "a": "FXI=1.0S/m:hip.ext+kn.ext/o:standing/l:bb@back", "b": "FXI=1.0S/m:hip.ext+kn.ext/o:standing/l:bb@?", "expect": {"relation": "refines", "layers": {"m": "equal", "o": "equal", "k": "equal", "f": "equal", "s": "equal", "l": "narrower", "x": "equal", "g": "equal", "r": "equal", "h": "equal", "p": "equal"}}, "note": "A known hold point refines @?."},
    {"id": "fxi-refines-unknown-grip", "kind": "fxi", "a": "FXI=1.0S/m:el.flex+sh.ext/o:seated/l:mach@hands/g:ne", "b": "FXI=1.0S/m:el.flex+sh.ext/o:seated/l:mach@hands/g:?", "expect": {"relation": "refines", "layers": {"m": "equal", "o": "equal", "k": "equal", "f": "equal", "s": "equal", "l": "equal", "x": "equal", "g": "narrower", "r": "equal", "h": "equal", "p": "equal"}}, "note": "Grip known against grip unknown."},
    {"id": "fxi-default-is-a-value", "kind": "fxi", "a": "FXI=1.0S/m:el.flex+sh.ext/o:seated/l:mach@hands/g:ne", "b": "FXI=1.0S/m:el.flex+sh.ext/o:seated/l:mach@hands", "expect": {"relation": "contradicting", "layers": {"m": "equal", "o": "equal", "k": "equal", "f": "equal", "s": "equal", "l": "equal", "x": "equal", "g": "contradicts", "r": "equal", "h": "equal", "p": "equal"}}, "note": "An absent layer takes its default, which contradicts every other known value."},
    {"id": "fxi-default-symmetry", "kind": "fxi", "a": "FXI=1.0S/m:el.flex/o:standing/l:db@hands/x:u", "b": "FXI=1.0S/m:el.flex/o:standing/l:db@hands", "expect": {"relation": "contradicting", "layers": {"m": "equal", "o": "equal", "k": "equal", "f": "equal", "s": "equal", "l": "contradicts", "x": "contradicts", "g": "equal", "r": "equal", "h": "equal", "p": "equal"}}, "note": "One arm at a time against the default both together. The load differs too: one arm at a time usually holds one dumbbell, both arms two."},
    {"id": "fxi-count-kept-against-completion", "kind": "fxi", "a": "FXI=1.0S/m:el.flex/o:standing/l:db*2@hands/x:?", "b": "FXI=1.0S/m:el.flex/o:standing/l:db@hands", "expect": {"relation": "refined-by", "layers": {"m": "equal", "o": "equal", "k": "equal", "f": "equal", "s": "equal", "l": "equal", "x": "broader", "g": "equal", "r": "equal", "h": "equal", "p": "equal"}}, "note": "A count kept because the symmetry is unknown equals the usual count the completed form leaves out: two dumbbells either way."},
    {"id": "fxi-count-kept-contradicts-completion", "kind": "fxi", "a": "FXI=1.0S/m:el.flex/o:standing/l:db*1@hands/x:?", "b": "FXI=1.0S/m:el.flex/o:standing/l:db@hands", "expect": {"relation": "contradicting", "layers": {"m": "equal", "o": "equal", "k": "equal", "f": "equal", "s": "equal", "l": "contradicts", "x": "broader", "g": "equal", "r": "equal", "h": "equal", "p": "equal"}}, "note": "One dumbbell against the two a both-arms curl usually holds."},
    {"id": "fxi-refined-by-unknown-phase", "kind": "fxi", "a": "FXI=1.0S/m:hip.ext>?/o:standing/l:kb@hands", "b": "FXI=1.0S/m:hip.ext>el.flex/o:standing/l:kb@hands", "expect": {"relation": "refined-by", "layers": {"m": "broader", "o": "equal", "k": "equal", "f": "equal", "s": "equal", "l": "equal", "x": "equal", "g": "equal", "r": "equal", "h": "equal", "p": "equal"}}, "note": "A ? phase is broader than any phase."},
    {"id": "fxi-refined-by-unknown-direction", "kind": "fxi", "a": "FXI=1.0S/m:el.ext+sh.?/o:standing/l:db@hands", "b": "FXI=1.0S/m:el.ext+sh.flex/o:standing/l:db@hands", "expect": {"relation": "refined-by", "layers": {"m": "broader", "o": "equal", "k": "equal", "f": "equal", "s": "equal", "l": "equal", "x": "equal", "g": "equal", "r": "equal", "h": "equal", "p": "equal"}}, "note": "sh.? covers every shoulder action."},
    {"id": "fxi-refined-by-unknown-point", "kind": "fxi", "a": "FXI=1.0S/m:el.ext+sh.hadd/o:prone/s:floor@feet,?/l:bw", "b": "FXI=1.0S/m:el.ext+sh.hadd/o:prone/s:floor@feet,hands/l:bw", "expect": {"relation": "refined-by", "layers": {"m": "equal", "o": "equal", "k": "equal", "f": "equal", "s": "broader", "l": "equal", "x": "equal", "g": "equal", "r": "equal", "h": "equal", "p": "equal"}}, "note": "A ? body point stands for one more point."},
    {"id": "fxi-child-support-refines-parent", "kind": "fxi", "a": "FXI=1.0S/m:el.ext+sh.hadd/o:prone/s:dome.up@hands+floor@feet/l:bw", "b": "FXI=1.0S/m:el.ext+sh.hadd/o:prone/s:dome@hands+floor@feet/l:bw", "expect": {"relation": "refines", "layers": {"m": "equal", "o": "equal", "k": "equal", "f": "equal", "s": "narrower", "l": "equal", "x": "equal", "g": "equal", "r": "equal", "h": "equal", "p": "equal"}}, "note": "dome covers dome.up."},
    {"id": "fxi-child-range-refines-parent", "kind": "fxi", "a": "FXI=1.0S/m:ank.pf+hip.ext+kn.ext>el.flex>hip.ext+kn.ext/o:standing/l:bb@hands/r:from-top.knee", "b": "FXI=1.0S/m:ank.pf+hip.ext+kn.ext>el.flex>hip.ext+kn.ext/o:standing/l:bb@hands/r:from-top", "expect": {"relation": "refines", "layers": {"m": "equal", "o": "equal", "k": "equal", "f": "equal", "s": "equal", "l": "equal", "x": "equal", "g": "equal", "r": "narrower", "h": "equal", "p": "equal"}}, "note": "from-top covers from-top.knee."},
    {"id": "fxi-child-cardio-refines-parent", "kind": "fxi", "a": "FXI=1.0S/m:~el.flex+hip.ext+kn.ext+sh.ext/o:seated/l:erg.row@hands", "b": "FXI=1.0S/m:~el.flex+hip.ext+kn.ext+sh.ext/o:seated/l:erg@hands", "expect": {"relation": "refines", "layers": {"m": "equal", "o": "equal", "k": "equal", "f": "equal", "s": "equal", "l": "narrower", "x": "equal", "g": "equal", "r": "equal", "h": "equal", "p": "equal"}}, "note": "erg covers every erg.<cycle>."},
    {"id": "fxi-sibling-children-contradict", "kind": "fxi", "a": "FXI=1.0S/m:el.ext+sh.hadd/o:prone/s:dome.up@hands+floor@feet/l:bw", "b": "FXI=1.0S/m:el.ext+sh.hadd/o:prone/s:dome.down@hands+floor@feet/l:bw", "expect": {"relation": "contradicting", "layers": {"m": "equal", "o": "equal", "k": "equal", "f": "equal", "s": "contradicts", "l": "equal", "x": "equal", "g": "equal", "r": "equal", "h": "equal", "p": "equal"}}, "note": "Two children of one parent contradict."},
    {"id": "fxi-narrowing-both-ways", "kind": "fxi", "a": "FXI=1.0S/m:hip.ext+kn.ext/o:standing/l:?@back", "b": "FXI=1.0S/m:hip.ext+kn.ext/o:*/l:bb@back", "expect": {"relation": "compatible", "layers": {"m": "equal", "o": "narrower", "k": "equal", "f": "equal", "s": "equal", "l": "broader", "x": "equal", "g": "equal", "r": "equal", "h": "equal", "p": "equal"}}, "note": "Each side is more specific in a different layer."},
    {"id": "fxi-both-open", "kind": "fxi", "a": "FXI=1.0S/m:hip.ext+kn.ext/o:?/l:bb@back", "b": "FXI=1.0S/m:hip.ext+kn.ext/o:*/l:bb@back", "expect": {"relation": "compatible", "layers": {"m": "equal", "o": "open", "k": "equal", "f": "equal", "s": "equal", "l": "equal", "x": "equal", "g": "equal", "r": "equal", "h": "equal", "p": "equal"}}, "note": "? against * is open."},
    {"id": "fxi-different-exercises", "kind": "fxi", "a": "FXI=1.0S/m:hip.ext+kn.ext/o:standing/l:bb@back", "b": "FXI=1.0S/m:el.flex/o:standing/l:db@hands", "expect": {"relation": "contradicting", "layers": {"m": "contradicts", "o": "equal", "k": "equal", "f": "equal", "s": "equal", "l": "contradicts", "x": "equal", "g": "equal", "r": "equal", "h": "equal", "p": "equal"}}, "note": "A squat and a curl."},
    {"id": "fxi-different-hold", "kind": "fxi", "a": "FXI=1.0S/m:hip.ext+kn.ext/o:standing/l:bb@back", "b": "FXI=1.0S/m:hip.ext+kn.ext/o:standing/l:bb@shoulders", "expect": {"relation": "contradicting", "layers": {"m": "equal", "o": "equal", "k": "equal", "f": "equal", "s": "equal", "l": "contradicts", "x": "equal", "g": "equal", "r": "equal", "h": "equal", "p": "equal"}}, "note": "Back and front: the hold point is part of the load."},
    {"id": "fxi-different-implement-count", "kind": "fxi", "a": "FXI=1.0S/m:hip.ext+kn.ext/o:standing/l:db@hands+vest@chest", "b": "FXI=1.0S/m:hip.ext+kn.ext/o:standing/l:db@hands", "expect": {"relation": "contradicting", "layers": {"m": "equal", "o": "equal", "k": "equal", "f": "equal", "s": "equal", "l": "contradicts", "x": "equal", "g": "equal", "r": "equal", "h": "equal", "p": "equal"}}, "note": "Every implement must pair with one on the other side."},
    {"id": "fxi-phase-count-differs", "kind": "fxi", "a": "FXI=1.0S/m:hip.ext>el.flex/o:standing/l:kb@hands", "b": "FXI=1.0S/m:hip.ext/o:standing/l:kb@hands", "expect": {"relation": "contradicting", "layers": {"m": "contradicts", "o": "equal", "k": "equal", "f": "equal", "s": "equal", "l": "equal", "x": "equal", "g": "equal", "r": "equal", "h": "equal", "p": "equal"}}, "note": "Different numbers of phases never unify."},
    {"id": "fxi-prefix-differs", "kind": "fxi", "a": "FXI=1.0S/m:%hip.ext/o:kneeling.half/l:bw/x:u", "b": "FXI=1.0S/m:&hip.ext/o:kneeling.half/l:bw/x:u", "expect": {"relation": "contradicting", "layers": {"m": "contradicts", "o": "equal", "k": "equal", "f": "equal", "s": "equal", "l": "equal", "x": "equal", "g": "equal", "r": "equal", "h": "equal", "p": "equal"}}, "note": "A static and a dynamic stretch."},
    {"id": "fxi-extended-one-side", "kind": "fxi", "a": "FXI=1.0N/m:%ank.df+kn.ext/o:seated/l:bw/x:u/a:strap", "b": "FXI=1.0S/m:%ank.df+kn.ext/o:seated/l:bw/x:u", "expect": {"relation": "refines", "layers": {"m": "equal", "o": "equal", "k": "equal", "f": "equal", "s": "equal", "l": "equal", "x": "equal", "g": "equal", "r": "equal", "h": "equal", "p": "equal"}}, "note": "An extended layer on one side only makes that side the more specific; it is not compared."},
    {"id": "fxi-extended-both-equal", "kind": "fxi", "a": "FXI=1.0N/m:%ank.df+kn.ext/o:seated/l:bw/x:u/a:strap", "b": "FXI=1.0N/m:%ank.df+kn.ext/o:seated/l:bw/x:u/a:strap", "expect": {"relation": "identical", "layers": {"m": "equal", "o": "equal", "k": "equal", "f": "equal", "s": "equal", "l": "equal", "x": "equal", "g": "equal", "r": "equal", "h": "equal", "p": "equal", "a": "equal"}}, "note": "An extended layer both sides carry is compared."},
    {"id": "fxi-extended-both-differ", "kind": "fxi", "a": "FXI=1.0N/m:%ank.df+kn.ext/o:seated/l:bw/x:u/a:strap", "b": "FXI=1.0N/m:%ank.df+kn.ext/o:seated/l:bw/x:u/a:partner", "expect": {"relation": "contradicting", "layers": {"m": "equal", "o": "equal", "k": "equal", "f": "equal", "s": "equal", "l": "equal", "x": "equal", "g": "equal", "r": "equal", "h": "equal", "p": "equal", "a": "contradicts"}}, "note": "Two different accessories."},
    {"id": "fxi-invalid-side", "kind": "fxi", "a": "FXI=1.0S/m:hip.ext+kn.ext/o:standing/l:bb@back", "b": "FXI=1.0S/m:hip.ext+kn.ext/o:upright/l:bb@back", "expect": {"relation": "invalid", "layers": {}}, "note": "Either string invalid makes the pair invalid."},
    {"id": "fxi-child-action-refines", "kind": "fxi", "a": "FXI=1.0S/m:el.flex+sh.ext.oh/o:seated/l:mach@hands/g:ne", "b": "FXI=1.0S/m:el.flex+sh.ext/o:seated/l:mach@hands/g:ne", "expect": {"relation": "refines", "layers": {"m": "narrower", "o": "equal", "k": "equal", "f": "equal", "s": "equal", "l": "equal", "x": "equal", "g": "equal", "r": "equal", "h": "equal", "p": "equal"}}, "note": "sh.ext covers its child sh.ext.oh: a pull from overhead refines a shoulder extension, it is not identical to it."},
    {"id": "fxi-child-action-under-prefix", "kind": "fxi", "a": "FXI=1.0S/m:^sh.ext.oh+sp.flex/o:standing/l:mb@hands", "b": "FXI=1.0S/m:^sh.ext+sp.flex/o:standing/l:mb@hands", "expect": {"relation": "refines", "layers": {"m": "narrower", "o": "equal", "k": "equal", "f": "equal", "s": "equal", "l": "equal", "x": "equal", "g": "equal", "r": "equal", "h": "equal", "p": "equal"}}, "note": "The parent covers its child under a phase prefix and beside other actions."},
    {"id": "fxi-child-action-held-part", "kind": "fxi", "a": "FXI=1.0S/m:=sp.flex|sh.ext.oh/o:prone/l:bw", "b": "FXI=1.0S/m:=sp.flex|sh.ext/o:prone/l:bw", "expect": {"relation": "refines", "layers": {"m": "narrower", "o": "equal", "k": "equal", "f": "equal", "s": "equal", "l": "equal", "x": "equal", "g": "equal", "r": "equal", "h": "equal", "p": "equal"}}, "note": "The parent covers its child in a part beside a held part."},
    {"id": "fxi-child-beside-parent-identical", "kind": "fxi", "a": "FXI=1.0S/m:el.flex+sh.ext+sh.ext.oh/o:seated/l:mach@hands", "b": "FXI=1.0S/m:el.flex+sh.ext.oh/o:seated/l:mach@hands", "expect": {"relation": "identical", "layers": {"m": "equal", "o": "equal", "k": "equal", "f": "equal", "s": "equal", "l": "equal", "x": "equal", "g": "equal", "r": "equal", "h": "equal", "p": "equal"}}, "note": "A parent written beside its child in one part is dropped by the canonical form, so the two strings are the same string."},
    {"id": "fxi-child-beside-parent-refines-parent", "kind": "fxi", "a": "FXI=1.0S/m:el.flex+sh.ext+sh.ext.oh/o:seated/l:mach@hands", "b": "FXI=1.0S/m:el.flex+sh.ext/o:seated/l:mach@hands", "expect": {"relation": "refines", "layers": {"m": "narrower", "o": "equal", "k": "equal", "f": "equal", "s": "equal", "l": "equal", "x": "equal", "g": "equal", "r": "equal", "h": "equal", "p": "equal"}}, "note": "Canonicalised, the string holds the child alone, so it refines a 1.3 string that wrote the parent: rebuilding such a record under 1.4 is a refinement, never a contradiction."},
    {"id": "fxi-child-action-sibling", "kind": "fxi", "a": "FXI=1.0S/m:el.flex+sh.ext.oh/o:seated/l:mach@hands", "b": "FXI=1.0S/m:el.flex+sh.add/o:seated/l:mach@hands", "expect": {"relation": "contradicting", "layers": {"m": "contradicts", "o": "equal", "k": "equal", "f": "equal", "s": "equal", "l": "equal", "x": "equal", "g": "equal", "r": "equal", "h": "equal", "p": "equal"}}, "note": "A child action contradicts every action that is neither it nor its parent."},
    {"id": "fxi-line-neck-contradicts", "kind": "fxi", "a": "FXI=1.0S/m:el.ext+sh.hadd/o:supine/s:bench/l:bb@hands/g:w-n/p:neck", "b": "FXI=1.0S/m:el.ext+sh.hadd/o:supine/s:bench/l:bb@hands/g:w-n", "expect": {"relation": "contradicting", "layers": {"m": "equal", "o": "equal", "k": "equal", "f": "equal", "s": "equal", "l": "equal", "x": "equal", "g": "equal", "r": "equal", "h": "equal", "p": "contradicts"}}, "note": "p:neck contradicts the default line: a press to the throat is not the press to the chest of the same grip."},
    {"id": "fxi-line-double-contradicts", "kind": "fxi", "a": "FXI=1.0S/m:~ank.pf/o:standing/l:jrope@hands/p:double", "b": "FXI=1.0S/m:~ank.pf/o:standing/l:jrope@hands", "expect": {"relation": "contradicting", "layers": {"m": "equal", "o": "equal", "k": "equal", "f": "equal", "s": "equal", "l": "equal", "x": "equal", "g": "equal", "r": "equal", "h": "equal", "p": "contradicts"}}, "note": "p:double contradicts the default line."},
    {"id": "fxi-held-push-contradicts", "kind": "fxi", "a": "FXI=1.0S/m:=kn.flex|hip.flex+sp.flex/o:supine/k:trunk/l:bw", "b": "FXI=1.0S/m:hip.flex+sp.flex/o:supine/k:trunk/l:bw", "expect": {"relation": "contradicting", "layers": {"m": "contradicts", "o": "equal", "k": "equal", "f": "equal", "s": "equal", "l": "equal", "x": "equal", "g": "equal", "r": "equal", "h": "equal", "p": "equal"}}, "note": "A held push is a part of its own: a phase with it contradicts the phase without it."},
    {"id": "fxi-mixed-kinds", "kind": "mixed", "a": "FXI=1.0S/m:hip.ext+kn.ext/o:standing/l:bb@back", "b": "FXE=1.0S/k:imp/f:bar.straight", "expect": {"relation": "invalid", "layers": {}}, "note": "An FXI and an FXE do not compare."},
    {"id": "fxe-identical", "kind": "fxe", "a": "FXE=1.0S/k:imp/f:bar.straight", "b": "FXE=1.0S/k:imp/f:bar.straight", "expect": {"relation": "identical", "layers": {"k": "equal", "f": "equal"}}, "note": "Byte-equal canonical strings with no ?."},
    {"id": "fxe-child-form-refines-parent", "kind": "fxe", "a": "FXE=1.0S/k:imp/f:band.loop", "b": "FXE=1.0S/k:imp/f:band", "expect": {"relation": "refines", "layers": {"k": "equal", "f": "narrower"}}, "note": "band covers band.loop."},
    {"id": "fxe-known-form-refines-unknown", "kind": "fxe", "a": "FXE=1.0S/k:imp/f:bar.straight", "b": "FXE=1.0S/k:imp/f:?", "expect": {"relation": "refines", "layers": {"k": "equal", "f": "narrower"}}, "note": "A known form refines f:?."},
    {"id": "fxe-different-forms", "kind": "fxe", "a": "FXE=1.0S/k:imp/f:bar.straight", "b": "FXE=1.0S/k:imp/f:bar.ez", "expect": {"relation": "contradicting", "layers": {"k": "equal", "f": "contradicts"}}, "note": "Two forms of one kind."},
    {"id": "fxe-different-kinds", "kind": "fxe", "a": "FXE=1.0S/k:imp/f:band", "b": "FXE=1.0S/k:sup/f:bench", "expect": {"relation": "contradicting", "layers": {"k": "contradicts"}}, "note": "Kinds that differ contradict, and nothing else is compared."},
    {"id": "fxe-unknown-kind", "kind": "fxe", "a": "FXE=1.0S/k:?", "b": "FXE=1.0S/k:imp/f:band", "expect": {"relation": "refined-by", "layers": {"k": "broader"}}, "note": "k:? covers every kind."},
    {"id": "fxe-machine-unknown-posture", "kind": "fxe", "a": "FXE=1.0S/k:mac/l:hand/s:?/m:pull.back", "b": "FXE=1.0S/k:mac/l:hand/s:seat/m:pull.back", "expect": {"relation": "refined-by", "layers": {"k": "equal", "l": "equal", "s": "broader", "m": "equal"}}, "note": "One machine layer unknown."},
    {"id": "fxe-machine-different-motion", "kind": "fxe", "a": "FXE=1.0S/k:mac/l:hand/s:seat/m:pull.back", "b": "FXE=1.0S/k:mac/l:hand/s:seat/m:pull.down", "expect": {"relation": "contradicting", "layers": {"k": "equal", "l": "equal", "s": "equal", "m": "contradicts"}}, "note": "Two guided motions."},
    {"id": "fxe-extended-one-side", "kind": "fxe", "a": "FXE=1.0N/k:mac/l:hand/s:seat/m:pull.back/r:stack/c:cable", "b": "FXE=1.0S/k:mac/l:hand/s:seat/m:pull.back", "expect": {"relation": "refines", "layers": {"k": "equal", "l": "equal", "s": "equal", "m": "equal"}}, "note": "Build details on one side only make it the more specific."},
    {"id": "fxe-extended-both-differ", "kind": "fxe", "a": "FXE=1.0N/k:mac/l:hand/s:seat/m:pull.back/r:stack", "b": "FXE=1.0N/k:mac/l:hand/s:seat/m:pull.back/r:plate", "expect": {"relation": "contradicting", "layers": {"k": "equal", "l": "equal", "s": "equal", "m": "equal", "r": "contradicts"}}, "note": "Two drives."},
    {"id": "fxe-cardio-unknown-track", "kind": "fxe", "a": "FXE=1.0S/k:erg/c:?/l:foot/s:stand/m:step", "b": "FXE=1.0S/k:erg/c:belt/l:foot/s:stand/m:step", "expect": {"relation": "refined-by", "layers": {"k": "equal", "c": "broader", "l": "equal", "s": "equal", "m": "equal"}}, "note": "A cardio machine whose track is unknown."},
    {"id": "fxe-combination-identical", "kind": "fxe", "a": "FXE=1.0S/k:mac/l:arm/s:seat/m:sh.hadd;k:mac/l:hand/s:seat.chest/m:sh.habd", "b": "FXE=1.0S/k:mac/l:arm/s:seat/m:sh.hadd;k:mac/l:hand/s:seat.chest/m:sh.habd", "expect": {"relation": "identical", "layers": {}}, "note": "The same combination, with no ?."},
    {"id": "fxe-combination-with-unknown", "kind": "fxe", "a": "FXE=1.0S/k:mac/l:arm/s:seat/m:sh.hadd;k:mac/l:hand/s:?/m:sh.habd", "b": "FXE=1.0S/k:mac/l:arm/s:seat/m:sh.hadd;k:mac/l:hand/s:?/m:sh.habd", "expect": {"relation": "compatible", "layers": {}}, "note": "The same combination holding ? is not identical."},
    {"id": "fxe-combination-contains-configuration", "kind": "fxe", "a": "FXE=1.0S/k:mac/l:arm/s:seat/m:sh.hadd;k:mac/l:hand/s:seat.chest/m:sh.habd", "b": "FXE=1.0S/k:mac/l:hand/s:seat.chest/m:sh.habd", "expect": {"relation": "compatible", "layers": {}}, "note": "A combination is compatible with a configuration it contains."},
    {"id": "fxe-combination-other-configuration", "kind": "fxe", "a": "FXE=1.0S/k:mac/l:arm/s:seat/m:sh.hadd;k:mac/l:hand/s:seat.chest/m:sh.habd", "b": "FXE=1.0S/k:mac/l:hand/s:seat/m:pull.back", "expect": {"relation": "contradicting", "layers": {}}, "note": "A configuration the combination does not contain."},
    {"id": "fxe-invalid-side", "kind": "fxe", "a": "FXE=1.0S/k:imp/f:bar.golden", "b": "FXE=1.0S/k:imp/f:bar.straight", "expect": {"relation": "invalid", "layers": {}}, "note": "Either string invalid makes the pair invalid."},
    {"id": "fxm-same-muscle", "kind": "fxm", "a": "FXM=1.0/alpha", "b": "FXM=1.0/alpha", "expect": {"grade": "identical", "shared": ["alpha.lower", "alpha.upper"]}, "note": "A muscle with parts is all its parts."},
    {"id": "fxm-group-equals-muscle", "kind": "fxm", "a": "FXM=1.0/g:only-beta", "b": "FXM=1.0/beta", "expect": {"grade": "identical", "shared": ["beta"]}, "note": "A group and a muscle with the same leaves are identical."},
    {"id": "fxm-muscle-contains-part", "kind": "fxm", "a": "FXM=1.0/alpha", "b": "FXM=1.0/alpha.upper", "expect": {"grade": "contains", "shared": ["alpha.upper"], "container": "a"}, "note": "The whole muscle contains its part."},
    {"id": "fxm-part-in-muscle", "kind": "fxm", "a": "FXM=1.0/alpha.upper", "b": "FXM=1.0/alpha", "expect": {"grade": "contains", "shared": ["alpha.upper"], "container": "b"}, "note": "The container is named from either side."},
    {"id": "fxm-nested-group-contains", "kind": "fxm", "a": "FXM=1.0/g:all", "b": "FXM=1.0/gamma.short", "expect": {"grade": "contains", "shared": ["gamma.short"], "container": "a"}, "note": "A group of groups covers its members' leaves."},
    {"id": "fxm-groups-overlap", "kind": "fxm", "a": "FXM=1.0/g:alpha-beta", "b": "FXM=1.0/g:uppers", "expect": {"grade": "overlaps", "shared": ["alpha.upper"]}, "note": "Some leaves shared, neither contains the other."},
    {"id": "fxm-disjoint", "kind": "fxm", "a": "FXM=1.0/beta", "b": "FXM=1.0/gamma", "expect": {"grade": "disjoint", "shared": []}, "note": "No leaf shared."}
