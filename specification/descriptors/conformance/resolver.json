    {"id": "confirm-entry-no-provenance", "query": {"id": "q", "fxi": "FXI=1.0S/m:hip.ext+kn.ext/o:standing/l:bb@back", "fxiProvenance": "owner", "fxiGap": null}, "library": [{"id": "back-squat", "fxi": "FXI=1.0S/m:hip.ext+kn.ext/o:standing/l:bb@back", "fxiGap": null}], "expect": {"kind": "confirm", "reason": "entry-not-owner", "candidates": [{"id": "back-squat", "via": "fxi", "relation": "identical"}]}, "note": "A library entry with no provenance."},
