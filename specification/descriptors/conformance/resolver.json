{
  "tier": "resolver",
  "rules": "1.4",
  "description": "The match protocol. Each vector matches one query row against a library and expects auto (with the library id), confirm (with the reason code and the ranked candidates, each with how it entered the list), or absent. The list holds at most top entries, three when top is not given. A vector never has two refusal reasons at once, so the order in which an implementation checks them is not tested.",
  "reasons": {
    "no-identical": "No library entry is identical to the query.",
    "several-identical": "More than one library entry is identical to the query.",
    "query-gap": "The query carries a gap marker.",
    "entry-gap": "The identical library entry carries a gap marker.",
    "query-import": "The query is an import-mode row.",
    "entry-import": "The identical library entry is an import-mode row.",
    "query-not-owner": "The query has neither owner nor owner-assisted provenance.",
    "entry-not-owner": "The identical library entry has neither owner nor owner-assisted provenance.",
    "fxe-differs": "Both the query and the identical library entry carry an FXE, and the two do not compare identical."
  },
