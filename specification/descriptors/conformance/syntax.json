{
  "tier": "syntax",
  "rules": "1.3",
  "description": "Parse, validate and canonicalise FXI, FXE and FXM strings. A valid vector expects the canonical string (and, where given, the standard projection). An invalid vector expects exactly the set of issue codes listed: the vectors are written so that each breaks one rule, and list a second code only where breaking that rule necessarily breaks another. A vector marked \"vocabulary\" is checked against fxm-vocabulary.json; every other FXM vector checks the format alone.",
  "vocabulary": "fxm-vocabulary.json",
  "codes": {
    "prefix": "The string does not start with the descriptor header (`FXI=`, `FXE=` or `FXM=`, then the version).",
    "no-rev": "The header has a major version but no syntax revision (`FXI=1/`): a pre-release draft.",
    "major": "A major version other than `1`.",
    "rev": "A syntax revision newer than the checker knows, or one written with a leading zero.",
    "unknown-layer": "A layer letter the descriptor does not have, or, in FXE, one the kind does not take.",
    "duplicate-layer": "A layer written twice.",
    "empty": "A layer, or a support item, with no value.",
    "missing-motion": "An FXI without the motion layer `m`.",
    "generic-motion": "`m:*`: the motion cannot be generic.",
    "part-unknown": "A motion phase with several `|` parts, one of them `?`.",
    "empty-phase": "A motion phase with no joint action.",
    "two-prefixes": "A motion part with more than one phase prefix.",
    "zero": "`0` anywhere but `=0` or `~0`.",
    "open-hedge": "The open-ended `+?` in a motion phase.",
    "unknown-action": "A motion item that is not a joint action, a joint with `?`, or a joint that circles with `.circ`.",
    "short-suffix": "The short-drive suffix `-` on anything but a named joint action.",
    "opposite-actions": "Two opposite actions in one part of a phase.",
    "unknown-code": "A code not in its vocabulary: an orientation, moving end, footwork, held posture, line or accessory, or an FXE value.",
    "unknown-surface": "A support surface that is not a support token.",
    "unknown-point": "A body point not in the body-point vocabulary.",
    "unknown-implement": "A load token that is not an equipment token.",
    "support-as-load": "A support token written as a load.",
    "count": "An implement count other than `1` to `4`.",
    "unknown-hold": "A hold point that is neither a body point nor a hold-only point.",
    "bw-hold": "`bw` with a hold point or a count.",
    "missing-hold": "An implement without a hold point.",
    "unknown-symmetry": "A symmetry code not in the vocabulary.",
    "unknown-scope": "A symmetry scope other than `arms` or `legs`.",
    "symmetry-conflict": "More than one symmetry code without scopes, or two for one scope.",
    "st-sp": "`st-sp` in `g`: split stance is footwork, `f:split`.",
    "unknown-grip": "A grip element that is not a hand orientation, width or stance.",
    "grip-conflict": "More than one hand orientation, width or stance in one grip phase.",
    "unknown-range": "A range code not in the vocabulary.",
    "range-conflict": "Two start positions, or `partial` with `deep`.",
    "unknown-alone": "`?` combined with other codes in `h`, `p` or `a`.",
    "conflict": "A default code combined with others, or two codes marked \"never with\".",
    "missing-kind": "An FXE configuration that does not start with `k`.",
    "kind-unknown": "`k:?` with other layers.",
    "unknown-kind": "An FXE kind not in the vocabulary.",
    "form-kind": "An FXE form written under a kind it does not belong to.",
    "combo": "A combination that joins `k:none` or `k:?`.",
    "token": "An FXM body that is not `<muscle>`, `<muscle>.<part>` or `g:<group>` in lowercase kebab-case.",
    "unknown-muscle": "An FXM muscle the vocabulary does not define.",
    "unknown-part": "An FXM part the muscle does not have in the vocabulary.",
    "unknown-group": "An FXM group the vocabulary does not define."
  },
  "vectors": [
    {"id": "fxi-already-canonical", "kind": "fxi", "input": "FXI=1.0S/m:hip.ext+kn.ext/o:standing/l:bb@back", "expect": {"valid": true, "canonical": "FXI=1.0S/m:hip.ext+kn.ext/o:standing/l:bb@back"}, "note": "A canonical string is its own canonical form."},
    {"id": "fxi-layer-order", "kind": "fxi", "input": "FXI=1.0S/l:bb@back/o:standing/m:kn.ext+hip.ext", "expect": {"valid": true, "canonical": "FXI=1.0S/m:hip.ext+kn.ext/o:standing/l:bb@back"}, "note": "Layers are written in the order m o k f s l x g r h p a, and + items are sorted."},
    {"id": "fxi-surrounding-space", "kind": "fxi", "input": "  FXI=1.0S/m:hip.ext+kn.ext/o:standing/l:bb@back\n", "expect": {"valid": true, "canonical": "FXI=1.0S/m:hip.ext+kn.ext/o:standing/l:bb@back"}, "note": "Leading and trailing whitespace is not part of the string."},
    {"id": "fxi-no-flag", "kind": "fxi", "input": "FXI=1.0/m:hip.ext+kn.ext/o:standing/l:bb@back", "expect": {"valid": true, "canonical": "FXI=1.0S/m:hip.ext+kn.ext/o:standing/l:bb@back"}, "note": "A missing flag is accepted and written."},
    {"id": "fxi-defaults-dropped", "kind": "fxi", "input": "FXI=1.0S/m:hip.ext+kn.ext/o:standing/k:limbs/f:level/l:bb@back/x:b/h:none/p:usual", "expect": {"valid": true, "canonical": "FXI=1.0S/m:hip.ext+kn.ext/o:standing/l:bb@back"}, "note": "Every layer written at its default is dropped."},
    {"id": "fxi-default-grip-dropped", "kind": "fxi", "input": "FXI=1.0S/m:hip.ext+kn.ext/o:standing/l:bb@back/g:w-m+st-m", "expect": {"valid": true, "canonical": "FXI=1.0S/m:hip.ext+kn.ext/o:standing/l:bb@back"}, "note": "w-m and st-m are the default width and stance."},
    {"id": "fxi-bare-floor-dropped", "kind": "fxi", "input": "FXI=1.0S/m:hip.ext+kn.ext/o:standing/s:floor/l:bb@back", "expect": {"valid": true, "canonical": "FXI=1.0S/m:hip.ext+kn.ext/o:standing/l:bb@back"}, "note": "A support that is only the floor is the default."},
    {"id": "fxi-implied-point-dropped", "kind": "fxi", "input": "FXI=1.0S/m:el.ext+sh.hadd/o:prone/s:floor@hands,feet,chest/l:bw", "expect": {"valid": true, "canonical": "FXI=1.0S/m:el.ext+sh.hadd/o:prone/s:floor@feet,hands/l:bw"}, "note": "prone implies the chest; body points are sorted."},
    {"id": "fxi-unknown-point-sorts-last", "kind": "fxi", "input": "FXI=1.0S/m:el.ext+sh.hadd/o:prone/s:floor@?,feet/l:bw", "expect": {"valid": true, "canonical": "FXI=1.0S/m:el.ext+sh.hadd/o:prone/s:floor@feet,?/l:bw"}, "note": "? sorts after every letter."},
    {"id": "fxi-seated-bench-dropped", "kind": "fxi", "input": "FXI=1.0S/m:el.ext+sh.flex/o:seated/s:bench/l:db@hands", "expect": {"valid": true, "canonical": "FXI=1.0S/m:el.ext+sh.flex/o:seated/l:db@hands"}, "note": "A bare bench under a seated body is implied."},
    {"id": "fxi-supine-bench-kept", "kind": "fxi", "input": "FXI=1.0S/m:el.ext+sh.hadd/o:supine/s:bench/l:bb@hands", "expect": {"valid": true, "canonical": "FXI=1.0S/m:el.ext+sh.hadd/o:supine/s:bench/l:bb@hands"}, "note": "A bench under a supine body is written."},
    {"id": "fxi-roller-implied-point", "kind": "fxi", "input": "FXI=1.0S/m:~0/o:supine/s:roller@back/l:bw", "expect": {"valid": true, "canonical": "FXI=1.0S/m:~0/o:supine/s:roller/l:bw"}, "note": "~0 is rolling; supine implies the back on the support."},
    {"id": "fxi-balance-hold", "kind": "fxi", "input": "FXI=1.0S/m:=0/o:standing/s:board/l:bw", "expect": {"valid": true, "canonical": "FXI=1.0S/m:=0/o:standing/s:board/l:bw"}, "note": "=0 is a balance hold with no joint direction."},
    {"id": "fxi-bodyweight-dropped-with-implement", "kind": "fxi", "input": "FXI=1.0S/m:hip.ext+kn.ext/o:standing/l:bw+kb@chest", "expect": {"valid": true, "canonical": "FXI=1.0S/m:hip.ext+kn.ext/o:standing/l:kb@chest"}, "note": "bw is dropped when an implement is written."},
    {"id": "fxi-implements-sorted", "kind": "fxi", "input": "FXI=1.0S/m:hip.ext+kn.ext/o:standing/f:travel.fwd/l:vest@chest+db@hands", "expect": {"valid": true, "canonical": "FXI=1.0S/m:hip.ext+kn.ext/o:standing/f:travel.fwd/l:db@hands+vest@chest"}, "note": "Several implements are sorted."},
    {"id": "fxi-implement-count", "kind": "fxi", "input": "FXI=1.0S/m:hip.ext+sh.flex/o:standing/l:kb*1@hands", "expect": {"valid": true, "canonical": "FXI=1.0S/m:hip.ext+sh.flex/o:standing/l:kb*1@hands"}, "note": "A count from 1 to 4 is written after the token."},
    {"id": "fxi-unknown-hold", "kind": "fxi", "input": "FXI=1.0S/m:hip.ext+kn.ext/o:standing/l:kb@?", "expect": {"valid": true, "canonical": "FXI=1.0S/m:hip.ext+kn.ext/o:standing/l:kb@?"}, "note": "An unknown hold point is @?."},
    {"id": "fxi-all-unknown", "kind": "fxi", "input": "FXI=1.0S/m:?/o:?/l:?", "expect": {"valid": true, "canonical": "FXI=1.0S/m:?/o:?/l:?"}, "note": "m, o and l may each be ?."},
    {"id": "fxi-omitted-orientation-and-load", "kind": "fxi", "input": "FXI=1.0S/m:hip.ext+kn.ext", "expect": {"valid": true, "canonical": "FXI=1.0S/m:hip.ext+kn.ext/o:?/l:?"}, "note": "An omitted o or l reads as ? and is written."},
    {"id": "fxi-generic-orientation", "kind": "fxi", "input": "FXI=1.0S/m:hip.ext+kn.ext/o:*/l:bb@back", "expect": {"valid": true, "canonical": "FXI=1.0S/m:hip.ext+kn.ext/o:*/l:bb@back"}, "note": "* is generic on purpose."},
    {"id": "fxi-orientation-run-collapsed", "kind": "fxi", "input": "FXI=1.0S/m:hip.ext+kn.ext/o:standing>standing/l:bb@back", "expect": {"valid": true, "canonical": "FXI=1.0S/m:hip.ext+kn.ext/o:standing/l:bb@back"}, "note": "A code repeated in a row in o is collapsed."},
    {"id": "fxi-phases-keep-order", "kind": "fxi", "input": "FXI=1.0S/m:ank.pf+hip.ext+kn.ext>el.flex>kn.ext+hip.ext/o:standing/l:bb@hands", "expect": {"valid": true, "canonical": "FXI=1.0S/m:ank.pf+hip.ext+kn.ext>el.flex>hip.ext+kn.ext/o:standing/l:bb@hands"}, "note": "Phases keep rep order; actions inside a phase are sorted."},
    {"id": "fxi-parts-sorted", "kind": "fxi", "input": "FXI=1.0S/m:hip.ext+sh.flex|=sp.flex/o:prone/s:floor@feet,hands/l:bw/x:a", "expect": {"valid": true, "canonical": "FXI=1.0S/m:=sp.flex|hip.ext+sh.flex/o:prone/s:floor@feet,hands/l:bw/x:a"}, "note": "Parts joined by | are sorted in code-unit order."},
    {"id": "fxi-short-drive", "kind": "fxi", "input": "FXI=1.0S/m:hip.ext>el.flex>sh.flex+el.ext+kn.ext-+hip.ext-/o:standing/l:kb@hands/x:u@arms", "expect": {"valid": true, "canonical": "FXI=1.0S/m:hip.ext>el.flex>el.ext+hip.ext-+kn.ext-+sh.flex/o:standing/l:kb@hands/x:u@arms"}, "note": "The short-drive suffix stays on its action."},
    {"id": "fxi-unknown-direction", "kind": "fxi", "input": "FXI=1.0S/m:sh.?+el.ext/o:standing/l:db@hands", "expect": {"valid": true, "canonical": "FXI=1.0S/m:el.ext+sh.?/o:standing/l:db@hands"}, "note": "A joint with ? for its direction."},
    {"id": "fxi-static-stretch-unknown-joints", "kind": "fxi", "input": "FXI=1.0S/m:%?/o:seated/l:bw", "expect": {"valid": true, "canonical": "FXI=1.0S/m:%?/o:seated/l:bw"}, "note": "A static stretch of unknown joints."},
    {"id": "fxi-scope-implied", "kind": "fxi", "input": "FXI=1.0S/m:hip.ext+kn.ext/o:standing/f:step.fwd/l:db@hands/x:u@legs", "expect": {"valid": true, "canonical": "FXI=1.0S/m:hip.ext+kn.ext/o:standing/f:step.fwd/l:db@hands/x:u"}, "note": "A scope the motion already implies is dropped."},
    {"id": "fxi-scope-kept", "kind": "fxi", "input": "FXI=1.0S/m:el.ext+sh.flex>hip.ext+kn.ext/o:standing/f:step.fwd/l:db@hands/x:u@legs", "expect": {"valid": true, "canonical": "FXI=1.0S/m:el.ext+sh.flex>hip.ext+kn.ext/o:standing/f:step.fwd/l:db@hands/x:u@legs"}, "note": "A scope the motion does not imply is kept."},
    {"id": "fxi-two-scopes", "kind": "fxi", "input": "FXI=1.0S/m:el.ext+sh.flex>hip.ext+kn.ext/o:standing/l:db@hands/x:u@legs+a@arms", "expect": {"valid": true, "canonical": "FXI=1.0S/m:el.ext+sh.flex>hip.ext+kn.ext/o:standing/l:db@hands/x:a@arms+u@legs"}, "note": "One symmetry code per scope, sorted."},
    {"id": "fxi-trunk-rotation-no-sides", "kind": "fxi", "input": "FXI=1.0S/m:sp.rot/o:seated/l:mb@hands/x:a", "expect": {"valid": true, "canonical": "FXI=1.0S/m:sp.rot/o:seated/l:mb@hands"}, "note": "x is dropped for a motion that is only trunk rotation."},
    {"id": "fxi-usual-hand-dropped", "kind": "fxi", "input": "FXI=1.0S/m:el.flex+sh.ext/o:seated/l:mach@hands/g:pr", "expect": {"valid": true, "canonical": "FXI=1.0S/m:el.flex+sh.ext/o:seated/l:mach@hands"}, "note": "pr is the usual hand orientation unless every action is el.flex."},
    {"id": "fxi-usual-curl-hand-dropped", "kind": "fxi", "input": "FXI=1.0S/m:el.flex/o:standing/l:db@hands/g:su", "expect": {"valid": true, "canonical": "FXI=1.0S/m:el.flex/o:standing/l:db@hands"}, "note": "su is the usual hand orientation when every action is el.flex."},
    {"id": "fxi-neutral-kept", "kind": "fxi", "input": "FXI=1.0S/m:el.flex+sh.ext/o:seated/l:mach@hands/g:w-m+ne", "expect": {"valid": true, "canonical": "FXI=1.0S/m:el.flex+sh.ext/o:seated/l:mach@hands/g:ne"}, "note": "A non-usual hand orientation is kept; w-m is dropped."},
    {"id": "fxi-trap-bar-forces-neutral", "kind": "fxi", "input": "FXI=1.0S/m:hip.ext+kn.ext/o:standing/l:tb@hands/g:ne", "expect": {"valid": true, "canonical": "FXI=1.0S/m:hip.ext+kn.ext/o:standing/l:tb@hands"}, "note": "A trap bar forces ne, so ne is dropped."},
    {"id": "fxi-stance-dropped-when-lying", "kind": "fxi", "input": "FXI=1.0S/m:el.ext+sh.hadd/o:supine/s:bench/l:bb@hands/g:st-w", "expect": {"valid": true, "canonical": "FXI=1.0S/m:el.ext+sh.hadd/o:supine/s:bench/l:bb@hands"}, "note": "A stance is dropped unless the body stands or the feet push a foot plate."},
    {"id": "fxi-stance-kept-on-foot-plate", "kind": "fxi", "input": "FXI=1.0S/m:hip.ext+kn.ext/o:supine.incline/l:mach@feet/g:st-n", "expect": {"valid": true, "canonical": "FXI=1.0S/m:hip.ext+kn.ext/o:supine.incline/l:mach@feet/g:st-n"}, "note": "A stance is kept when the feet push a machine foot plate."},
    {"id": "fxi-grip-change-kept", "kind": "fxi", "input": "FXI=1.0S/m:el.flex/o:standing/l:db@hands/g:pr>su", "expect": {"valid": true, "canonical": "FXI=1.0S/m:el.flex/o:standing/l:db@hands/g:pr>su"}, "note": "A grip that changes during the rep keeps every phase."},
    {"id": "fxi-grip-run-collapsed", "kind": "fxi", "input": "FXI=1.0S/m:el.flex/o:standing/l:db@hands/g:su>su", "expect": {"valid": true, "canonical": "FXI=1.0S/m:el.flex/o:standing/l:db@hands"}, "note": "A repeated grip phase collapses to one, then the usual hand is dropped."},
    {"id": "fxi-range-sorted", "kind": "fxi", "input": "FXI=1.0S/m:hip.ext+kn.ext/o:standing/l:bb@hands/r:from-floor+deficit", "expect": {"valid": true, "canonical": "FXI=1.0S/m:hip.ext+kn.ext/o:standing/l:bb@hands/r:deficit+from-floor"}, "note": "Range codes are sorted."},
    {"id": "fxi-held-sorted", "kind": "fxi", "input": "FXI=1.0S/m:sh.abd/o:standing/l:db@hands/h:el.bent+arms.side", "expect": {"valid": true, "canonical": "FXI=1.0S/m:sh.abd/o:standing/l:db@hands/h:arms.side+el.bent"}, "note": "Held codes are sorted."},
    {"id": "fxi-accessory-sets-flag", "kind": "fxi", "input": "FXI=1.0S/m:%ank.df+kn.ext/o:seated/l:bw/x:u/a:strap", "expect": {"valid": true, "canonical": "FXI=1.0N/m:%ank.df+kn.ext/o:seated/l:bw/x:u/a:strap", "standard": "FXI=1.0S/m:%ank.df+kn.ext/o:seated/l:bw/x:u"}, "note": "The flag is N exactly when an extended layer is written."},
    {"id": "fxi-accessory-none-clears-flag", "kind": "fxi", "input": "FXI=1.0N/m:%ank.df+kn.ext/o:seated/l:bw/x:u/a:none", "expect": {"valid": true, "canonical": "FXI=1.0S/m:%ank.df+kn.ext/o:seated/l:bw/x:u"}, "note": "a:none is the default; with no extended layer left the flag is S."},
    {"id": "fxi-prefix", "kind": "fxi", "input": "FXJ=1.0S/m:hip.ext+kn.ext/o:standing/l:bw", "expect": {"valid": false, "issues": ["prefix"]}, "note": "Not an FXI at all."},
    {"id": "fxi-prefix-lowercase", "kind": "fxi", "input": "fxi=1.0S/m:hip.ext+kn.ext/o:standing/l:bw", "expect": {"valid": false, "issues": ["prefix"]}, "note": "The header is case-sensitive."},
    {"id": "fxi-no-revision", "kind": "fxi", "input": "FXI=1/m:hip.ext+kn.ext/o:standing/l:bw", "expect": {"valid": false, "issues": ["no-rev"]}, "note": "A pre-release draft header without the syntax revision."},
    {"id": "fxi-major", "kind": "fxi", "input": "FXI=2.0S/m:hip.ext+kn.ext/o:standing/l:bw", "expect": {"valid": false, "issues": ["major"]}, "note": "Only major 1 is defined."},
    {"id": "fxi-revision-ahead", "kind": "fxi", "input": "FXI=1.9S/m:hip.ext+kn.ext/o:standing/l:bw", "expect": {"valid": false, "issues": ["rev"]}, "note": "A syntax revision this checker does not know."},
    {"id": "fxi-revision-leading-zero", "kind": "fxi", "input": "FXI=1.00S/m:hip.ext+kn.ext/o:standing/l:bw", "expect": {"valid": false, "issues": ["rev"]}, "note": "The revision has no leading zeros."},
    {"id": "fxi-unknown-layer", "kind": "fxi", "input": "FXI=1.0S/m:hip.ext+kn.ext/o:standing/l:bw/z:1", "expect": {"valid": false, "issues": ["unknown-layer"]}, "note": "z is not a layer."},
    {"id": "fxi-duplicate-layer", "kind": "fxi", "input": "FXI=1.0S/m:hip.ext+kn.ext/o:standing/o:seated/l:bw", "expect": {"valid": false, "issues": ["duplicate-layer"]}, "note": "A layer written twice."},
    {"id": "fxi-empty-layer", "kind": "fxi", "input": "FXI=1.0S/m:hip.ext+kn.ext/o:standing/l:bw/g:", "expect": {"valid": false, "issues": ["empty"]}, "note": "A layer with no value."},
    {"id": "fxi-missing-motion", "kind": "fxi", "input": "FXI=1.0S/o:standing/l:bw", "expect": {"valid": false, "issues": ["missing-motion"]}, "note": "m is required."},
    {"id": "fxi-generic-motion", "kind": "fxi", "input": "FXI=1.0S/m:*/o:standing/l:bw", "expect": {"valid": false, "issues": ["generic-motion"]}, "note": "m cannot be generic."},
    {"id": "fxi-unknown-part", "kind": "fxi", "input": "FXI=1.0S/m:el.flex|?/o:standing/l:db@hands", "expect": {"valid": false, "issues": ["part-unknown"]}, "note": "A phase with several parts cannot hold a ? part."},
    {"id": "fxi-empty-phase", "kind": "fxi", "input": "FXI=1.0S/m:hip.ext>/o:standing/l:bw", "expect": {"valid": false, "issues": ["empty-phase"]}, "note": "A phase needs at least one joint action."},
    {"id": "fxi-two-prefixes", "kind": "fxi", "input": "FXI=1.0S/m:%=hip.ext/o:standing/l:bw", "expect": {"valid": false, "issues": ["two-prefixes", "unknown-action"]}, "note": "A phase takes one prefix. The second prefix is read as part of the action, which is then not a joint action either."},
    {"id": "fxi-bare-zero", "kind": "fxi", "input": "FXI=1.0S/m:0/o:standing/l:bw", "expect": {"valid": false, "issues": ["zero"]}, "note": "0 is valid only as =0 or ~0."},
    {"id": "fxi-open-hedge", "kind": "fxi", "input": "FXI=1.0S/m:hip.ext+?/o:standing/l:bw", "expect": {"valid": false, "issues": ["open-hedge"]}, "note": "The open-ended +? is not allowed."},
    {"id": "fxi-unknown-action", "kind": "fxi", "input": "FXI=1.0S/m:hip.twist/o:standing/l:bw", "expect": {"valid": false, "issues": ["unknown-action"]}, "note": "Not a joint action."},
    {"id": "fxi-short-suffix", "kind": "fxi", "input": "FXI=1.0S/m:hip.?-/o:standing/l:bw", "expect": {"valid": false, "issues": ["short-suffix"]}, "note": "The short-drive suffix goes only on a named joint action."},
    {"id": "fxi-opposite-actions", "kind": "fxi", "input": "FXI=1.0S/m:el.flex+el.ext/o:standing/l:db@hands", "expect": {"valid": false, "issues": ["opposite-actions"]}, "note": "Opposite actions in one phase."},
    {"id": "fxi-unknown-orientation", "kind": "fxi", "input": "FXI=1.0S/m:hip.ext+kn.ext/o:upright/l:bw", "expect": {"valid": false, "issues": ["unknown-code"]}, "note": "Not an orientation."},
    {"id": "fxi-unknown-surface", "kind": "fxi", "input": "FXI=1.0S/m:hip.ext+kn.ext/o:standing/s:trampoline@feet/l:bw", "expect": {"valid": false, "issues": ["unknown-surface"]}, "note": "Not a support surface."},
    {"id": "fxi-load-as-surface", "kind": "fxi", "input": "FXI=1.0S/m:el.ext+sh.hadd/o:prone/s:bw@hands/l:bw", "expect": {"valid": false, "issues": ["unknown-surface"]}, "note": "bw is a load, never a support surface."},
