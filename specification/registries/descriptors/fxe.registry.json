    "guidedMotionVerbs": {
      "layer": "m",
      "description": "Multi-joint `mac` guided motion: a verb, `.`, then a direction.",
      "entries": [
        {"value":"push","description":"The moving part is pushed away."},
        {"value":"pull","description":"The moving part is pulled toward the user."},
        {"value":"assist","description":"The moving part helps lift the body."}
      ]
    },
    "guidedMotionDirections": {
      "layer": "m",
      "description": "Direction of a multi-joint `mac` guided motion, relative to the trunk.",
      "entries": [
        {"value":"up","description":"Toward the head: shoulder press, hack squat, belt squat, deadlift machine."},
        {"value":"down","description":"Toward the feet: pulldown, seated dip."},
        {"value":"fwd","description":"Away from the front of the trunk: chest press, leg press."},
        {"value":"back","description":"Toward the front of the trunk: row."},
        {"value":"fwdup","description":"Forward and up: incline press."},
        {"value":"fwddown","description":"Forward and down: decline press."},
        {"value":"backdown","description":"Back and down: high row."}
      ]
