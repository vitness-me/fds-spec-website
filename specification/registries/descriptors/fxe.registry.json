{
  "registry": "fxe",
  "descriptor": "FXE",
  "status": "draft",
  "syntax": "1.0",
  "rules": "1.3",
  "policy": "closed",
  "description": "The FXE alphabet: every code an FXE string may contain, by layer and kind. Closed within a rules revision. These are classes of equipment structure, not a catalogue of products.",
  "vocabularies": {
    "kinds": {
      "layer": "k",
      "description": "The kind of equipment. `standard` layers are always written, in this order, `?` when unknown; `extended` layers only in a full registry record.",
      "entries": [
        {"value":"none","description":"No equipment: the body is the whole load.","standard":[],"extended":[]},
        {"value":"imp","description":"Implement: a free object moved, held or worn.","standard":["f"],"extended":["r","c"]},
        {
          "value": "sup",
          "description": "Support: a surface or frame the body rests on, hangs from or pushes against. It does not carry the load.",
          "standard": ["f"],
          "extended": ["c"]
        },
        {
          "value": "acc",
          "description": "Accessory: a handle, strap, belt, mat, towel or marker. It never defines the exercise.",
          "standard": ["f"],
          "extended": []
        },
        {
          "value": "stn",
          "description": "Station: a guide or anchor with a general interface used for many movements: cable column, Smith machine, landmine.",
          "standard": ["f"],
          "extended": ["r","c","a"]
        },
        {
          "value": "mac",
          "description": "Dedicated machine: a guided mechanism with fixed body interfaces, built for one movement.",
          "standard": ["l","s","m"],
          "extended": ["r","c","g","a"]
        },
        {"value":"erg","description":"Cyclic machine: repeats whole cycles (cardio).","standard":["c","l","s","m"],"extended":["r"]}
      ]
    },
