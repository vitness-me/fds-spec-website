    "singleJointMotions": {
      "layer": "m",
      "description": "Single-joint `mac` guided motions: the FXI joint action the pivot lines up with.",
      "entries": [
        {"value":"kn.flex","description":"Knee flexion against resistance, as in a leg curl."},
        {"value":"kn.ext","description":"Knee extension, as in standing up from a squat."},
        {"value":"el.flex","description":"Elbow flexion, as in a curl."},
        {"value":"el.ext","description":"Elbow extension, as in a press or triceps extension."},
        {"value":"sh.flex","description":"Shoulder flexion: arm forward and up, as in a front raise or overhead press."},
        {"value":"sh.ext","description":"Shoulder extension: arm down and back from in front, as in a row or straight-arm pulldown."},
        {"value":"sh.abd","description":"Shoulder abduction: arm out to the side and up, as in a lateral raise."},
        {"value":"sh.add","description":"Shoulder adduction: arm down to the side from out to the side, as in a wide pull-up."},
        {"value":"sh.hadd","description":"Horizontal adduction: arm across the front at chest height, as in a press or fly."},
        {"value":"sh.habd","description":"Horizontal abduction: arm back and out at chest height, as in a reverse fly."},
        {"value":"sh.ir","description":"Shoulder internal rotation: forearm turns in toward the belly, elbow bent."},
        {"value":"sh.er","description":"Shoulder external rotation: forearm turns out, elbow bent."},
        {"value":"sc.elev","description":"Scapular elevation: shrug up."},
        {"value":"hip.flex","description":"Hip flexion: thigh toward the trunk, or trunk toward the thigh."},
        {"value":"hip.ext","description":"Hip extension: thigh away from the trunk, as in standing up from a squat."},
        {"value":"hip.abd","description":"Hip abduction: leg out to the side."},
        {"value":"hip.add","description":"Hip adduction: leg in toward the other leg."},
        {"value":"sp.flex","description":"Trunk flexion: ribs toward the pelvis, as in a crunch."},
        {"value":"sp.ext","description":"Trunk extension: straightening or arching the back from a bent position."},
        {"value":"sp.rot","description":"Trunk rotation: shoulders twist against the hips."},
        {"value":"sp.lflex","description":"Trunk side bend."},
        {"value":"ank.pf","description":"Ankle plantar flexion: rising onto the toes, pushing off."},
        {"value":"ank.df","description":"Ankle dorsiflexion: toes toward the shin."},
        {"value":"nk.flex","description":"Neck flexion: chin toward the chest."},
        {"value":"nk.ext","description":"Neck extension: head tips back."},
        {"value":"nk.lflex","description":"Neck side bend: ear toward the shoulder."},
        {"value":"wr.flex","description":"Wrist flexion: palm toward the forearm."},
        {"value":"wr.ext","description":"Wrist extension: back of the hand toward the forearm."}
