  "layers": [
    {
      "letter": "m",
      "name": "Motion",
      "standard": true,
      "required": true,
      "description": "Motion: the joint actions of each phase, in rep order. Required."
    },
    {
      "letter": "o",
      "name": "Orientation",
      "standard": true,
      "required": true,
      "description": "Orientation: the body to gravity at the start of the rep. Always written; `?` if unknown."
    },
    {
      "letter": "k",
      "name": "Moving end",
      "standard": true,
      "required": false,
      "description": "Moving end, for trunk work on the floor or a bench. Default: the limb end moves."
    },
    {
      "letter": "f",
      "name": "Footwork",
      "standard": true,
      "required": false,
      "description": "Footwork: stepping, split stance or travel. Default: feet planted level."
    },
    {
      "letter": "s",
      "name": "Support",
      "standard": true,
      "required": false,
      "description": "Support: surfaces beyond what the orientation implies, and the body points on them. Default: the floor as the orientation implies."
    },
    {
      "letter": "l",
      "name": "Load",
      "standard": true,
      "required": true,
      "description": "Load: each implement and where it is held, or `none`. Always written; `?` if unknown."
    },
    {
      "letter": "x",
      "name": "Sides",
      "standard": true,
      "required": false,
      "description": "Sides: whether the limbs work together, one side at a time, in turns or in opposite directions. Default: `b`, both together."
    },
    {
      "letter": "g",
      "name": "Grip and stance",
      "standard": true,
      "required": false,
      "description": "Grip and stance: hand orientation, width, stance. Default: the usual grip, medium width, medium stance."
    },
    {
      "letter": "r",
      "name": "Range and start",
      "standard": true,
      "required": false,
      "description": "Range and start: partial or deep range, deficit, start position. Default: full range from the usual start."
    },
    {
      "letter": "h",
      "name": "Held posture",
      "standard": true,
      "required": false,
      "description": "Held posture of limbs that do not work. Default: no held posture."
    },
    {
      "letter": "p",
      "name": "Line of pull",
      "standard": true,
      "required": false,
      "description": "Line of pull or path past the body. Default: the line the movement implies."
    },
    {
      "letter": "a",
      "name": "Accessory",
      "standard": false,
      "required": false,
      "description": "Accessory: a strap or a partner that helps the exercise without loading it. Extended: compared only when both keys carry it."
    }
  ],
