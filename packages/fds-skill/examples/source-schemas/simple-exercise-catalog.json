{
  "$comment": "fds:not-a-field — Example source schema: a gym's own exercise list, written for this repository. It is the input side of a mapping, so none of its field names are FDS.",
  "schema": {
    "type": "array",
    "items": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "description": "The gym's own code for the exercise"
        },
        "name": {
          "type": "string",
          "description": "Exercise name, as the gym writes it"
        },
        "region": {
          "type": "string",
          "description": "Where on the body the work is",
          "enum": [
            "lower body",
            "upper body",
            "trunk",
            "whole body"
          ]
        },
        "equipment": {
          "type": "string",
          "description": "What the exercise is done with",
          "enum": [
            "none",
            "barbell",
            "dumbbell",
            "kettlebell",
            "cable",
            "machine",
            "band"
          ]
        },
        "primaryMuscle": {
          "type": "string",
          "description": "The muscle the gym lists first",
          "enum": [
            "quadriceps",
            "glutes",
            "hamstrings",
            "chest",
            "latissimus dorsi",
            "shoulders",
            "triceps",
            "biceps",
            "abdominals"
          ]
        },
        "videoUrl": {
          "type": "string",
          "description": "A demonstration video"
        }
      },
      "required": [
        "code",
        "name",
        "region",
        "equipment",
        "primaryMuscle"
      ]
    }
  },
  "examples": [
    {
      "code": "gym-101",
      "name": "dead bug",
      "region": "trunk",
      "equipment": "none",
      "primaryMuscle": "abdominals",
      "videoUrl": "https://example.com/media/dead-bug.mp4"
    },
    {
      "code": "gym-102",
      "name": "barbell floor press",
      "region": "upper body",
      "equipment": "barbell",
      "primaryMuscle": "chest",
      "videoUrl": "https://example.com/media/barbell-floor-press.mp4"
    },
    {
      "code": "gym-103",
      "name": "half-kneeling one-arm cable pulldown",
      "region": "upper body",
      "equipment": "cable",
      "primaryMuscle": "latissimus dorsi",
      "videoUrl": "https://example.com/media/half-kneeling-one-arm-cable-pulldown.mp4"
    }
  ]
}
