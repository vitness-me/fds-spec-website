{
  "$comment": "fds:not-a-field — Example source schema: a simple exercise catalogue format. It is the input side of a mapping, so none of its field names are FDS.",
  "schema": {
    "type": "array",
    "items": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier in the source catalogue"
        },
        "name": {
          "type": "string",
          "description": "Exercise name"
        },
        "bodyPart": {
          "type": "string",
          "description": "General body region",
          "enum": [
            "legs",
            "back",
            "chest",
            "shoulders",
            "arms",
            "core",
            "full body"
          ]
        },
        "equipment": {
          "type": "string",
          "description": "Equipment needed",
          "enum": [
            "body weight",
            "barbell",
            "dumbbell",
            "kettlebell",
            "cable",
            "machine",
            "band",
            "other"
          ]
        },
        "target": {
          "type": "string",
          "description": "Primary target muscle",
          "enum": [
            "quads",
            "hamstrings",
            "glutes",
            "calves",
            "lats",
            "pectorals",
            "delts",
            "biceps",
            "triceps",
            "abs"
          ]
        },
        "mediaUrl": {
          "type": "string",
          "description": "URL of a demonstration video"
        }
      },
      "required": [
        "id",
        "name",
        "bodyPart",
        "equipment",
        "target",
        "mediaUrl"
      ]
    }
  },
  "examples": [
    {
      "id": "vx-0001",
      "name": "3/4 crunch",
      "bodyPart": "core",
      "equipment": "body weight",
      "target": "abs",
      "mediaUrl": "https://example.com/media/three-quarter-crunch.mp4"
    },
    {
      "id": "vx-0002",
      "name": "barbell bench press",
      "bodyPart": "chest",
      "equipment": "barbell",
      "target": "pectorals",
      "mediaUrl": "https://example.com/media/barbell-bench-press.mp4"
    },
    {
      "id": "vx-0003",
      "name": "seated cable row",
      "bodyPart": "back",
      "equipment": "cable",
      "target": "lats",
      "mediaUrl": "https://example.com/media/seated-cable-row.mp4"
    }
  ]
}
